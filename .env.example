# intel-audit — service-mode environment.
# In library mode your host builds audit.Config itself; these are the container's inputs.
# See docs/configuration.md. Provider credentials are NOT here: they belong to the
# channel implementations your host constructs, which is why a shared deployment can
# hold per-tenant keys without the engine knowing any of them.

# --- required: no safe default exists for these -------------------------------
# The product identity. Two products sharing a deployment MUST NOT share a realm,
# or they share an idempotency key space and silently swallow each other's
# audits as replays. Cannot be retrofitted cheaply.
AUDIT_REALM=

AUDIT_PG_DSN=postgres://postgres:postgres@localhost:5432/audit?sslmode=disable
AUDIT_REDIS_URL=redis://localhost:6379/0

# --- delivery ------------------------------------------------------------------
AUDIT_DELIVERY=outbox          # outbox (crash-safe, default) | direct (dev / in-app only)
AUDIT_MAX_ATTEMPTS=5
AUDIT_BACKOFF_BASE=10s
AUDIT_BACKOFF_CEILING=1h

# Fixed for the deployment's life. Changing it live re-maps in-flight rows to
# different drainers and DOUBLE-DELIVERS. Drain the outbox first -- see
# docs/operations.md#changing-the-shard-count.
AUDIT_SHARDS=16

# --- lifecycle -----------------------------------------------------------------
AUDIT_RETENTION_WINDOW=2160h       # 90d, read audits
AUDIT_DEAD_LETTER_RETENTION=720h   # 30d, independent of the inbox window
AUDIT_DEFAULT_LOCALE=en
AUDIT_DIGEST_MAX=100

# --- bus -----------------------------------------------------------------------
AUDIT_SUBJECT_PREFIX=audit
AUDIT_BUS=redis-streams        # redis-streams (default) | nats
# AUDIT_NATS_URL=nats://localhost:4222
